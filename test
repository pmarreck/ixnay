#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEST_DIR="$ROOT_DIR/tests"

exit_code=0

for test_script in "$TEST_DIR"/*_test.sh; do
	[ -e "$test_script" ] || continue
	if bash "$test_script"; then
		script_status=0
	else
		script_status=$?
	fi
	exit_code=$((exit_code + script_status))
done

exit $exit_code
